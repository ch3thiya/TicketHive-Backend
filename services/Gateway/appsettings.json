{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/identity/{**catch-all}" }
      },
      "catalog": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/catalog/{**catch-all}" }
      },
      "inventory": {
        "ClusterId": "inventory",
        "Match": { "Path": "/api/inventory/{**catch-all}" }
      },
      "waitingroom": {
        "ClusterId": "waitingroom",
        "Match": { "Path": "/api/waiting-room/{**catch-all}" }
      },
      "booking": {
        "ClusterId": "booking",
        "Match": { "Path": "/api/booking/{**catch-all}" }
      },
      "payment": {
        "ClusterId": "payment",
        "Match": { "Path": "/api/payment/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": {
        "HttpRequest": { "ActivityTimeout": "00:01:40" },
        "Destinations": { "primary": { "Address": "http://localhost:5051" } }
      },
      "catalog": {
        "HttpRequest": { "ActivityTimeout": "00:01:40" },
        "Destinations": { "primary": { "Address": "http://localhost:5142" } }
      },
      "inventory": {
        "HttpRequest": { "ActivityTimeout": "00:01:40" },
        "Destinations": { "primary": { "Address": "http://localhost:5219" } }
      },
      "waitingroom": {
        "HttpRequest": { "ActivityTimeout": "00:01:40" },
        "Destinations": { "primary": { "Address": "http://localhost:5231" } }
      },
      "booking": {
        "HttpRequest": { "ActivityTimeout": "00:01:40" },
        "Destinations": { "primary": { "Address": "http://localhost:5005" } }
      },
      "payment": {
        "HttpRequest": { "ActivityTimeout": "00:01:40" },
        "Destinations": { "primary": { "Address": "http://localhost:5006" } }
      }
    }
  }
}
